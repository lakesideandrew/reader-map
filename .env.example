# Copy to .env for local runs. In GitHub Actions these are repository secrets/variables.

# Required for the weekly AI news check (npm run ai:check).
ANTHROPIC_API_KEY=sk-ant-...

# Model for the news check. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=claude-opus-5-5

# Hard ceiling per AI run, in US dollars. The run stops starting new
# searches once its estimated spend would pass this.
MAX_RUN_SPEND_USD=3
